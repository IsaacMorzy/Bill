---
import { navigationLinks } from '@utils/navigation';
import ThemeToggle from '@ui/ThemeToggle.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-[var(--theme-navbar-border,rgba(0,0,0,0.06))] bg-[var(--theme-navbar-bg,rgba(255,255,255,0.8))] backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--theme-amber)] text-sm font-bold text-white">
        BL
      </div>
      <div class="flex flex-col">
        <span class="text-lg font-bold leading-tight text-[var(--theme-amber)]">
          Bill Llia
        </span>
        <span class="text-[10px] font-medium uppercase tracking-[0.2em] text-[var(--theme-amber)]/70">
          For Governor
        </span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <div class="hidden items-center gap-1 md:flex">
      <a href="/" class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--theme-text-secondary)] transition-all hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">
        Home
      </a>
      <a href={navigationLinks.platform.href} class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--theme-text-secondary)] transition-all hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">
        {navigationLinks.platform.text}
      </a>
      <a href={navigationLinks.about.href} class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--theme-text-secondary)] transition-all hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">
        {navigationLinks.about.text}
      </a>
      <a href={navigationLinks.blog.href} class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--theme-text-secondary)] transition-all hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">
        {navigationLinks.blog.text}
      </a>
      <a href="/petition" class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--theme-amber)] transition-all hover:bg-[var(--theme-amber)]/10">
        Petition
      </a>
      <a href={navigationLinks.contact.href} class="rounded-lg px-3 py-2 text-sm font-medium text-[var(--theme-text-secondary)] transition-all hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">
        {navigationLinks.contact.text}
      </a>
    </div>

    <!-- CTA + Theme Toggle + Mobile Toggle -->
    <div class="flex items-center gap-1 md:gap-2">
      <ThemeToggle />

      <a
        href="/contact"
        class="hidden rounded-lg bg-[var(--theme-lime)] px-4 py-2 text-sm font-semibold text-[var(--color-warm-text)] transition-all hover:brightness-95 md:inline-block"
      >
        Join Us
      </a>

      <!-- Mobile menu button -->
      <button id="mobile-menu-toggle" class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--theme-text-secondary)] transition-colors hover:bg-[var(--theme-amber)]/10 md:hidden" aria-label="Toggle menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-[var(--theme-navbar-border,rgba(0,0,0,0.06))] bg-[var(--theme-surface,#ffffff)]/95 px-4 py-4 backdrop-blur-xl md:hidden">
    <div class="flex flex-col gap-1">
      <a href="/" class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--theme-text-secondary)] transition-colors hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">Home</a>
      <a href={navigationLinks.platform.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--theme-text-secondary)] transition-colors hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">{navigationLinks.platform.text}</a>
      <a href={navigationLinks.about.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--theme-text-secondary)] transition-colors hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">{navigationLinks.about.text}</a>
      <a href={navigationLinks.blog.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--theme-text-secondary)] transition-colors hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">{navigationLinks.blog.text}</a>
      <a href="/petition" class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--theme-amber)] transition-colors hover:bg-[var(--theme-amber)]/10">Petition</a>
      <a href={navigationLinks.contact.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--theme-text-secondary)] transition-colors hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]">{navigationLinks.contact.text}</a>
      <a href="/contact" class="mt-2 rounded-lg bg-[var(--theme-lime)] px-4 py-2.5 text-center text-sm font-semibold text-[var(--color-warm-text)]">Join Us</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    // Close on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
