---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Hero from '@sections/HeroSection.astro';
import FeatureShowcase from '@sections/FeatureShowcase.astro';
import DemandsShowcase from '@sections/DemandsShowcase.astro';
import BlogPreview from '@sections/BlogPreview.astro';
import CTA from '@sections/CTA.astro';

const reader = createReader(process.cwd(), keystaticConfig);
const settings = await reader.collections.settings.readOrThrow('site-settings');

const platformEntries = (await reader.collections.platform.all()) ?? [];

const rawDemands = (await reader.collections.demands.all()) ?? [];
const demands = await Promise.all(
  rawDemands
    .sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99))
    .map(async (d) => {
      const { node } = await d.entry.content();
      return {
        title: d.entry.title,
        order: d.entry.order ?? 0,
        content: node,
      };
    })
);

const rawPosts = (await reader.collections.posts.all()) ?? [];
const posts = rawPosts
  .sort((a, b) => {
    const dateA = a.entry.publishedDate ? new Date(a.entry.publishedDate).getTime() : 0;
    const dateB = b.entry.publishedDate ? new Date(b.entry.publishedDate).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 3)
  .map((p) => ({
    slug: p.slug,
    title: p.entry.title,
    publishedDate: p.entry.publishedDate ?? null,
    excerpt: p.entry.excerpt ?? null,
  }));

const pillars = platformEntries
  .map((item) => item.entry)
  .filter((p) => p.sectionType === 'platform')
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .map((p) => {
    const rawFeatures = p.features ?? [];
    const features = Array.isArray(rawFeatures) ? rawFeatures : [];
    return {
      title: p.title,
      subtitle: p.subtitle ?? '',
      icon: p.icon,
      features,
    };
  });

const rawStats = settings.heroStats;
const heroStats = Array.isArray(rawStats) ? rawStats : [];
---

<BaseLayout
  seo={{
    title: settings.defaultSeoTitle,
    description: settings.defaultSeoDescription,
  }}
>
  <Hero
    title={settings.heroTitle ?? ''}
    subtitle={settings.heroSubtitle ?? ''}
    stats={heroStats.map((s) => ({
      value: s.value ?? '',
      label: s.label ?? '',
    }))}
  />
  <FeatureShowcase {pillars} />
  <DemandsShowcase {demands} />
  <BlogPreview {posts} />
  <CTA
    title={settings.ctaTitle ?? ''}
    description={settings.ctaDescription ?? ''}
    primaryCTA={{
      text: settings.ctaPrimaryText ?? '',
      href: settings.ctaPrimaryHref ?? '',
    }}
    secondaryCTA={{
      text: settings.ctaSecondaryText ?? '',
      href: settings.ctaSecondaryHref ?? '',
    }}
  />
</BaseLayout>
