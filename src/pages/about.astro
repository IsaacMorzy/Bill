---
import BaseLayout from '@layout/BaseLayout.astro';

const seo = {
  title: 'About Bill Llia - Candidate for Governor, Nairobi County',
  description:
    'Learn about Bill Llia — his background, motivation for running, and vision for Nairobi County.',
};
---

<BaseLayout {seo}>
  <!-- Hero -->
  <section class="bg-[var(--theme-surface-muted)] pt-28 pb-16 sm:pb-20">
    <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <!-- Decorative -->
      <div class="absolute top-10 right-1/4 h-32 w-32 rounded-full bg-[var(--theme-amber)]/5 blur-2xl animate-float" />
      <div class="absolute bottom-10 left-1/4 h-24 w-24 rounded-full bg-[var(--theme-amber)]/5 blur-2xl animate-float-delayed" />

      <div class="relative">
        <h1 class="reveal text-4xl font-bold tracking-tight text-[var(--theme-text)] sm:text-5xl">
          About <span class="bg-gradient-to-r from-[var(--theme-amber)] to-[var(--theme-amber)]/70 bg-clip-text text-transparent">Bill Llia</span>
        </h1>
        <p class="reveal delay-100 mx-auto mt-4 max-w-2xl text-lg text-[var(--theme-text-secondary)]">
          A community servant, healthcare advocate, and candidate for Governor committed
          to building a better Nairobi County.
        </p>
      </div>
    </div>
  </section>

  <!-- Bio Section -->
  <section class="bg-[var(--theme-surface-muted)] py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Rooted in Community</h2>
          <div class="mt-6 space-y-5 text-base leading-relaxed text-[var(--theme-text-secondary)]">
            <p>
              Bill Llia is a dedicated public servant who has spent years working alongside
              communities across Nairobi County, building health programs, supporting youth
              initiatives, and advocating for better public services.
            </p>
            <p>
              With a background in community health and development, Bill has helped establish health
              centers and has empowered young people through skills training and mentorship
              programs. His work has taken him across every constituency in the county, giving him a deep
              understanding of the challenges and opportunities facing each community.
            </p>
            <p>
              Bill is running for Governor because he believes that lasting change comes
              from listening to the people and working together. He is not a career politician — he is a
              community servant who has seen firsthand what is possible when dedicated leaders show up
              and deliver.
            </p>
          </div>
        </div>

        <!-- Timeline -->
        <div class="reveal delay-100 mt-16">
          <h2 class="text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Journey</h2>
          <div class="mt-8 space-y-6">
            {[
              { year: '2012', title: 'Community Health Volunteer', desc: 'Began serving communities through local health initiatives and outreach programs.' },
              { year: '2016', title: 'Health Program Coordinator', desc: 'Led the establishment of 2 community health centers serving underserved wards.' },
              { year: '2020', title: 'Youth Empowerment Lead', desc: 'Launched skills training programs that have empowered 500+ young people.' },
              { year: '2024', title: 'Governor Candidate', desc: 'Announced candidacy for Governor of Nairobi County with a people-first platform.' },
            ].map((item, i) => (
              <div class="group relative flex gap-6">
                <div class="flex flex-col items-center">
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--theme-amber)]/20 text-xs font-bold text-[var(--theme-amber)] ring-1 ring-[var(--theme-amber)]/30 transition-all duration-300 group-hover:bg-[var(--theme-amber)] group-hover:text-white">
                    {i + 1}
                  </div>
                  {i < 3 && <div class="mt-1 h-full w-px bg-[var(--theme-border)]" />}
                </div>
                <div class="pb-6">
                  <span class="text-xs font-semibold uppercase tracking-wider text-[var(--theme-amber)]">{item.year}</span>
                  <h3 class="mt-1 text-lg font-semibold text-[var(--theme-text)]">{item.title}</h3>
                  <p class="mt-1 text-sm text-[var(--theme-text-secondary)]">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Motivation Section -->
  <section class="bg-[var(--theme-bg)] py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="reveal">
          <h2 class="text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Why I'm Running</h2>
          <div class="mt-6 space-y-5 text-base leading-relaxed text-[var(--theme-text-secondary)]">
            <p>
              I'm running because our people deserve better. Too many families in Nairobi County go
              without access to basic healthcare. Too many young people graduate with no path to employment.
              Too many small businesses struggle to thrive.
            </p>
            <p>
              These are not impossible problems. With focused leadership, transparent governance, and a
              genuine commitment to serving the people, we can transform our county. I have the experience,
              the energy, and the integrity to be the leader our community needs.
            </p>
            <p>
              I am not asking for your vote — I am asking for your trust. And I will earn it by showing up,
              listening, and delivering results.
            </p>
          </div>
        </div>

        <div class="reveal delay-100 mt-10 border-l-2 border-[var(--theme-amber)]/40 pl-6 transition-all duration-300 hover:border-[var(--theme-amber)]">
          <p class="text-lg font-medium italic text-[var(--theme-text)]">
            "Service with integrity. Leadership with heart."
          </p>
          <p class="mt-2 text-sm text-[var(--theme-text-tertiary)]">— Bill Llia</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="bg-[var(--theme-surface-muted)] py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="reveal text-center">
          <h2 class="text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Core Values</h2>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {[
            { title: 'Integrity', desc: 'Honest, transparent leadership that puts people before politics. Every decision made in the light of day.', icon: 'shield' },
            { title: 'Service', desc: 'Leadership is not about power. It is about serving the people who trust you with their future.', icon: 'heart' },
            { title: 'Progress', desc: 'Measurable, tangible progress that improves the daily lives of every resident in Nairobi County.', icon: 'trending' },
          ].map((value, i) => (
            <div
              class="reveal group rounded-xl border border-[var(--theme-border)] bg-[var(--theme-bg)]/60 p-6 transition-all duration-300 hover:border-[var(--theme-amber)]/30 hover:shadow-[var(--theme-card-hover-shadow)] hover:-translate-y-0.5"
              style={`animation-delay: ${i * 100}ms`}
            >
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--theme-amber)]/10 text-[var(--theme-amber)] transition-all duration-300 group-hover:scale-110 group-hover:rotate-3">
                {value.icon === 'shield' && (
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
                )}
                {value.icon === 'heart' && (
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                )}
                {value.icon === 'trending' && (
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
                )}
              </div>
              <h3 class="text-lg font-semibold text-[var(--theme-text)]">{value.title}</h3>
              <p class="mt-2 text-sm text-[var(--theme-text-secondary)]">{value.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-[var(--theme-bg)] py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="grid grid-cols-2 gap-6 rounded-2xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-8 sm:grid-cols-4">
          {[
            { value: '12+', label: 'Years Service' },
            { value: '4', label: 'Health Centers' },
            { value: '500+', label: 'Youth Empowered' },
            { value: '17', label: 'Wards Visited' },
          ].map((stat) => (
            <div class="text-center">
              <div class="text-2xl font-bold text-[var(--theme-amber)] transition-all duration-300 hover:scale-110">{stat.value}</div>
              <div class="mt-1 text-sm text-[var(--theme-text-secondary)]">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--theme-bg)] pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal mx-auto max-w-xl text-center">
        <h2 class="text-2xl font-bold text-[var(--theme-text)]">Join the Campaign</h2>
        <p class="mt-3 text-sm text-[var(--theme-text-secondary)]">
          Be part of the movement for change. Volunteer, donate, or spread the word.
        </p>
        <a
          href="/contact"
          class="group mt-6 inline-flex items-center gap-2 rounded-xl bg-[var(--theme-lime)] px-6 py-3 text-sm font-semibold text-[var(--color-warm-text)] shadow-lg transition-all hover:brightness-95 hover:-translate-y-0.5 active:translate-y-0"
        >
          Get Involved
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
