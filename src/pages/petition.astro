---
import BaseLayout from '@layout/BaseLayout.astro';
import { db, PetitionSignature } from 'astro:db';

const title = 'Sign the Petition — Bill Llia for Governor';
const description = 'Join the movement for better leadership in Nairobi County. Sign the petition to support Dr. Bill Llia for Governor.';

// Get signature count and query params
const signatures = await db.select().from(PetitionSignature);
const signatureCount = signatures.length;
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
---

<BaseLayout
  seo={{
    title,
    description,
    canonical: 'https://bill.vercel.app/petition',
  }}
>
  <main class="min-h-screen bg-[var(--theme-surface-muted)] pt-24">
    <!-- Hero Section -->
    <section class="relative overflow-hidden border-b border-[var(--theme-border)]">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/20 via-transparent to-transparent" />
      <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-amber-500/10 px-4 py-1.5 text-sm font-medium text-amber-400">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Citizen's Petition
        </div>
        <h1 class="bg-gradient-to-r from-blue-500 via-blue-400 to-amber-400 bg-clip-text text-4xl font-bold text-transparent sm:text-5xl lg:text-6xl">
          We Deserve Better Leadership
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--theme-text-secondary)]">
           Nairobi County deserves a leader who brings real solutions, not empty promises. 
           Dr. Bill Llia has the experience, vision, and integrity to serve as our next Governor. 
          Add your voice to the growing demand for change.
        </p>
        <p class="mt-4 text-sm text-[var(--theme-text-tertiary)]">
          <span class="font-semibold text-amber-400/80" id="signature-count">{signatureCount.toLocaleString()}</span> signatures and counting
        </p>
      </div>
    </section>

    <!-- Why We Need Change -->
    <section class="border-b border-[var(--theme-border)] py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Why This Matters</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <div class="rounded-xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6">
            <h3 class="text-lg font-semibold text-[var(--theme-text)]">Healthcare Access</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--theme-text-secondary)]">
              Our health centers are understaffed and under-equipped. We need a Governor who understands 
              healthcare from the inside — not a politician who treats it as an afterthought.
            </p>
          </div>
          <div class="rounded-xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6">
            <h3 class="text-lg font-semibold text-[var(--theme-text)]">Youth Unemployment</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--theme-text-secondary)]">
              Too many of our youth are unemployed or underemployed. We need real economic 
              empowerment programs, not token handouts during campaign season.
            </p>
          </div>
          <div class="rounded-xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6">
            <h3 class="text-lg font-semibold text-[var(--theme-text)]">Water & Sanitation</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--theme-text-secondary)]">
              Clean water is still a dream for many of our communities. We need a Governor who will 
              prioritize water infrastructure and hold contractors accountable.
            </p>
          </div>
          <div class="rounded-xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6">
            <h3 class="text-lg font-semibold text-[var(--theme-text)]">Education & Skills</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--theme-text-secondary)]">
              Our children deserve better schools, and our adults deserve skills training that 
              leads to actual jobs. The status quo is failing our community.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What We're Asking -->
    <section class="border-b border-[var(--theme-border)] py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Our Demands</h2>
        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-4 rounded-lg border border-[var(--theme-border)] bg-[var(--theme-surface)] p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600/20 text-sm font-bold text-blue-400">1</span>
            <div>
              <p class="text-[var(--theme-text)]">Quality healthcare that reaches every part of the county, not just the city centre</p>
            </div>
          </div>
          <div class="flex items-start gap-4 rounded-lg border border-[var(--theme-border)] bg-[var(--theme-surface)] p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600/20 text-sm font-bold text-blue-400">2</span>
            <div>
              <p class="text-[var(--theme-text)]">Real youth employment through skills training and enterprise support</p>
            </div>
          </div>
          <div class="flex items-start gap-4 rounded-lg border border-[var(--theme-border)] bg-[var(--theme-surface)] p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600/20 text-sm font-bold text-blue-400">3</span>
            <div>
              <p class="text-[var(--theme-text)]">Clean water access for all — no more broken infrastructure and empty promises</p>
            </div>
          </div>
          <div class="flex items-start gap-4 rounded-lg border border-[var(--theme-border)] bg-[var(--theme-surface)] p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600/20 text-sm font-bold text-blue-400">4</span>
            <div>
              <p class="text-[var(--theme-text)]">Transparent use of county resources — every shilling accounted for</p>
            </div>
          </div>
          <div class="flex items-start gap-4 rounded-lg border border-[var(--theme-border)] bg-[var(--theme-surface)] p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600/20 text-sm font-bold text-blue-400">5</span>
            <div>
              <p class="text-[var(--theme-text)]">Quality education infrastructure and vocational training centres</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Status Messages -->
    {
      success === 'true' && (
        <section class="py-8">
          <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
            <div class="rounded-xl border border-emerald-500/30 bg-emerald-900/20 p-6 text-center">
              <svg class="mx-auto h-10 w-10 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h3 class="mt-3 text-lg font-semibold text-emerald-300">Thank You for Signing!</h3>
              <p class="mt-1 text-sm text-emerald-200/70">
                Your voice matters. Share this petition with friends and family in Nairobi County.
              </p>
            </div>
          </div>
        </section>
      )
    }
    {
      error === 'missing-fields' && (
        <section class="py-8">
          <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
            <div class="rounded-xl border border-red-500/30 bg-red-900/20 p-6 text-center">
              <p class="text-sm font-medium text-red-300">Please fill in all required fields (name, email, and ward).</p>
            </div>
          </div>
        </section>
      )
    }
    {
      error === 'invalid-email' && (
        <section class="py-8">
          <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
            <div class="rounded-xl border border-red-500/30 bg-red-900/20 p-6 text-center">
              <p class="text-sm font-medium text-red-300">Please enter a valid email address.</p>
            </div>
          </div>
        </section>
      )
    }
    {
      error === 'server-error' && (
        <section class="py-8">
          <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
            <div class="rounded-xl border border-red-500/30 bg-red-900/20 p-6 text-center">
              <p class="text-sm font-medium text-red-300">Something went wrong. Please try again later.</p>
            </div>
          </div>
        </section>
      )
    }

    <!-- Sign Petition Form -->
    <section class="py-16">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-[var(--theme-border)] bg-gradient-to-b from-[var(--theme-surface-muted)] to-[var(--theme-bg)] p-8 shadow-2xl shadow-[var(--theme-border)]">
          <h2 class="text-center text-2xl font-bold text-[var(--theme-text)]">Add Your Name</h2>
          <p class="mt-2 text-center text-sm text-[var(--theme-text-secondary)]">
            Every signature brings us closer to the change Nairobi deserves.
          </p>
          <form class="mt-8 space-y-5" action="/api/petition" method="POST">
            <div>
              <label for="name" class="block text-sm font-medium text-[var(--theme-text)]">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-1.5 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] px-4 py-2.5 text-sm text-[var(--theme-text)] placeholder-[var(--theme-input-placeholder)] transition-colors focus:border-amber-500/50 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
                placeholder="e.g., Jane Doe"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-[var(--theme-text)]">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-1.5 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] px-4 py-2.5 text-sm text-[var(--theme-text)] placeholder-[var(--theme-input-placeholder)] transition-colors focus:border-amber-500/50 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
                placeholder="e.g., jane@example.com"
              />
            </div>
            <div>
                <label for="ward" class="block text-sm font-medium text-[var(--theme-text)]">Constituency</label>
              <select
                id="ward"
                name="ward"
                required
                class="mt-1.5 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] px-4 py-2.5 text-sm text-[var(--theme-text)] transition-colors focus:border-amber-500/50 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
              >
                <option value="" disabled selected class="bg-[var(--theme-surface-muted)]">Select your constituency</option>
                <option value="constituency-1" class="bg-[var(--theme-surface-muted)]">Constituency 1</option>
                <option value="constituency-2" class="bg-[var(--theme-surface-muted)]">Constituency 2</option>
                <option value="constituency-3" class="bg-[var(--theme-surface-muted)]">Constituency 3</option>
                <option value="constituency-4" class="bg-[var(--theme-surface-muted)]">Constituency 4</option>
                <option value="constituency-5" class="bg-[var(--theme-surface-muted)]">Constituency 5</option>
                <option value="constituency-6" class="bg-[var(--theme-surface-muted)]">Constituency 6</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-[var(--theme-text)]">Why do you support this cause? (optional)</label>
              <textarea
                id="message"
                name="message"
                rows="3"
                class="mt-1.5 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] px-4 py-2.5 text-sm text-[var(--theme-text)] placeholder-[var(--theme-input-placeholder)] transition-colors focus:border-amber-500/50 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
                placeholder="Share your reason..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full rounded-lg bg-gradient-to-r from-blue-600 to-amber-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/20 transition-all hover:from-blue-500 hover:to-amber-500"
            >
              Sign the Petition
            </button>
          </form>
          <p class="mt-4 text-center text-xs text-[var(--theme-text-tertiary)]">
            Your information will only be used for campaign coordination purposes.
          </p>
        </div>
      </div>
    </section>

    <!-- Share Section -->
    <section class="border-t border-[var(--theme-border)] py-12">
      <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
        <h3 class="text-lg font-semibold text-[var(--theme-text)]">Spread the Word</h3>
        <p class="mt-2 text-sm text-[var(--theme-text-secondary)]">
          Share this petition with friends and family in Nairobi County.
        </p>
        <div class="mt-6 flex items-center justify-center gap-4">
          <a
            href={`https://wa.me/?text=${encodeURIComponent('Sign the petition to support Dr. Bill Llia for Governor in Nairobi County: https://bill.vercel.app/petition')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-[var(--theme-input-border)] px-5 py-2.5 text-sm font-medium text-[var(--theme-text)] transition-colors hover:bg-blue-500/10"
          >
            Share on WhatsApp
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://bill.vercel.app/petition')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-[var(--theme-input-border)] px-5 py-2.5 text-sm font-medium text-[var(--theme-text)] transition-colors hover:bg-blue-500/10"
          >
            Share on Facebook
          </a>
          <button
            id="copy-link-btn"
            class="rounded-lg border border-[var(--theme-input-border)] px-5 py-2.5 text-sm font-medium text-[var(--theme-text)] transition-colors hover:bg-blue-500/10"
          >
            Copy Link
          </button>
        </div>
        <script>
          const copyBtn = document.getElementById('copy-link-btn');
          if (copyBtn) {
            copyBtn.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(window.location.href);
                const originalText = copyBtn.textContent;
                copyBtn.textContent = 'Copied!';
                setTimeout(() => { copyBtn.textContent = originalText; }, 2000);
              } catch {
                // Fallback for older browsers
                const textarea = document.createElement('textarea');
                textarea.value = window.location.href;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                const originalText = copyBtn.textContent;
                copyBtn.textContent = 'Copied!';
                setTimeout(() => { copyBtn.textContent = originalText; }, 2000);
              }
            });
          }
        </script>
      </div>
    </section>
  </main>
</BaseLayout>
