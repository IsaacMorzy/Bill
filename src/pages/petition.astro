---
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { db, PetitionSignature } from 'astro:db';

const reader = createReader(process.cwd(), keystaticConfig);
const settings = await reader.collections.settings.readOrThrow('site-settings');
const demandsEntries = await reader.collections.demands.all();

const title = 'Sign the Petition — Bill Llia for Governor';
const description = 'Join the movement for better leadership in Nairobi County. Sign the petition to support Dr. Bill Llia for Governor.';

// Get signature count
const signatures = await db.select().from(PetitionSignature);
const signatureCount = signatures.length;
const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');

// Goal from CMS
const goal = settings.petitionGoal ?? 1000;
const percentage = Math.min(Math.round((signatureCount / goal) * 100), 100);

// Get demands sorted by order
const demands = demandsEntries
  .map((item) => item.entry)
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout
  seo={{
    title,
    description,
    canonical: 'https://bill-two-alpha.vercel.app/petition',
  }}
>
  <main class="min-h-screen bg-[var(--theme-surface-muted)] pt-24">
    <!-- Hero Section -->
    <section class="relative overflow-hidden border-b border-[var(--theme-border)]">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[var(--theme-amber)]/[0.08] via-transparent to-transparent" />
      <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
        <div class="reveal mb-6 inline-flex items-center gap-2 rounded-full bg-[var(--theme-amber)]/10 px-4 py-1.5 text-sm font-medium text-[var(--theme-amber)]">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Citizen's Petition
        </div>
        <h1 class="reveal delay-100 bg-gradient-to-r from-[var(--theme-amber)] via-[var(--theme-amber)] to-[var(--theme-amber)]/70 bg-clip-text text-4xl font-bold text-transparent sm:text-5xl lg:text-6xl">
          {settings.petitionTitle ?? 'We Deserve Better Leadership'}
        </h1>
        <p class="reveal delay-200 mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--theme-text-secondary)]">
          {settings.petitionDescription ?? 'Nairobi County deserves a leader who brings real solutions, not empty promises.'}
        </p>

        <!-- Progress Bar -->
        <div class="reveal delay-300 mx-auto mt-10 max-w-xl">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm font-medium text-[var(--theme-text)]">Progress</span>
            <span class="text-sm text-[var(--theme-amber)] font-semibold">{signatureCount.toLocaleString()} / {goal.toLocaleString()}</span>
          </div>
          <div class="flex h-3 w-full rounded-full bg-[var(--theme-border)] overflow-hidden" role="progressbar" aria-valuenow={signatureCount} aria-valuemin="0" aria-valuemax={goal}>
            <div
              class="flex flex-col justify-center rounded-full bg-gradient-to-r from-[var(--theme-amber)] to-[var(--theme-lime)] text-xs text-[var(--color-warm-text)] text-center whitespace-nowrap transition-all duration-700 ease-out"
              style={`width: ${percentage}%`}
            />
          </div>
          <p class="mt-3 text-sm text-[var(--theme-text-tertiary)]">
            <span class="font-semibold text-[var(--theme-amber)]/80">{signatureCount.toLocaleString()}</span> signatures and counting
          </p>
        </div>
      </div>
    </section>

    <!-- Why We Need Change -->
    <section class="border-b border-[var(--theme-border)] py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="reveal text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Why This Matters</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {[
            { title: 'Healthcare Access', desc: 'Our health centers are understaffed and under-equipped. We need a Governor who understands healthcare from the inside — not a politician who treats it as an afterthought.' },
            { title: 'Youth Unemployment', desc: 'Too many of our youth are unemployed or underemployed. We need real economic empowerment programs, not token handouts during campaign season.' },
            { title: 'Water & Sanitation', desc: 'Clean water is still a dream for many of our communities. We need a Governor who will prioritize water infrastructure and hold contractors accountable.' },
            { title: 'Education & Skills', desc: 'Our children deserve better schools, and our adults deserve skills training that leads to actual jobs. The status quo is failing our community.' },
          ].map((item, i) => (
            <div
              class="reveal group rounded-xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6 transition-all duration-300 hover:border-[var(--theme-amber)]/30 hover:shadow-[var(--theme-card-hover-shadow)] hover:-translate-y-0.5"
              style={`animation-delay: ${i * 100}ms`}
            >
              <h3 class="text-lg font-semibold text-[var(--theme-text)] group-hover:text-[var(--theme-amber)] transition-colors">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--theme-text-secondary)]">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Our Demands from CMS -->
    <section class="border-b border-[var(--theme-border)] py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="reveal text-2xl font-bold text-[var(--theme-text)] sm:text-3xl">Our Demands</h2>
        <div class="mt-8 space-y-3">
          {demands.map((demand, i) => (
            <div
              class="reveal group flex items-start gap-4 rounded-lg border border-[var(--theme-border)] bg-[var(--theme-surface)] p-4 transition-all duration-300 hover:border-[var(--theme-amber)]/30 hover:shadow-sm"
              style={`animation-delay: ${i * 100}ms`}
            >
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--theme-amber)]/20 text-sm font-bold text-[var(--theme-amber)] transition-all duration-300 group-hover:scale-110 group-hover:bg-[var(--theme-amber)]/30 group-hover:text-white">{i + 1}</span>
              <p class="pt-1 text-[var(--theme-text)]">{demand.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Status Messages as Toast -->
    {
      success === 'true' && (
        <section class="py-8">
          <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
            <div class="reveal flex items-center gap-4 rounded-xl border border-emerald-500/30 bg-emerald-900/20 p-5">
              <svg class="h-8 w-8 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <h3 class="text-base font-semibold text-emerald-300">Thank You for Signing!</h3>
                <p class="text-sm text-emerald-200/70">Your voice matters. Share this petition with friends and family in Nairobi County.</p>
              </div>
            </div>
          </div>
        </section>
      )
    }
    {
      error && (
        <section class="py-8">
          <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
            <div class="reveal flex items-center gap-4 rounded-xl border border-red-500/30 bg-red-900/20 p-5">
              <svg class="h-8 w-8 shrink-0 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <h3 class="text-base font-semibold text-red-300">Something went wrong</h3>
                <p class="text-sm text-red-200/70">
                  {error === 'missing-fields' && 'Please fill in all required fields (name, email, and ward).'}
                  {error === 'invalid-email' && 'Please enter a valid email address.'}
                  {error === 'server-error' && 'Server error. Please try again later.'}
                </p>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- Sign Petition Form with Floating Labels -->
    <section class="py-16">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <div class="reveal rounded-2xl border border-[var(--theme-border)] bg-gradient-to-b from-[var(--theme-surface-muted)] to-[var(--theme-bg)] p-8 shadow-2xl shadow-[var(--theme-border)]">
          <h2 class="text-center text-2xl font-bold text-[var(--theme-text)]">Add Your Name</h2>
          <p class="mt-2 text-center text-sm text-[var(--theme-text-secondary)]">
            Every signature brings us closer to the change Nairobi deserves.
          </p>
          <form class="mt-8 space-y-5" action="/api/petition" method="POST">
            <!-- Name - Floating label -->
            <div class="relative">
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g., Jane Doe"
                class="peer p-4 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] text-sm text-[var(--theme-input-text)] placeholder:text-transparent transition-colors focus:border-[var(--theme-amber)]/50 focus:ring-2 focus:ring-[var(--theme-amber)]/20 focus:pt-6 focus:pb-2 not-placeholder-shown:pt-6 not-placeholder-shown:pb-2 autofill:pt-6 autofill:pb-2"
              />
              <label for="name" class="absolute top-0 start-0 p-4 h-full text-sm truncate pointer-events-none transition-all duration-100 border border-transparent text-[var(--theme-input-placeholder)] origin-[0_0] peer-focus:scale-90 peer-focus:translate-x-0.5 peer-focus:-translate-y-1.5 peer-focus:text-[var(--theme-amber)] peer-not-placeholder-shown:scale-90 peer-not-placeholder-shown:translate-x-0.5 peer-not-placeholder-shown:-translate-y-1.5 peer-not-placeholder-shown:text-[var(--theme-text-tertiary)]">
                Full Name
              </label>
            </div>
            <!-- Email - Floating label -->
            <div class="relative">
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="e.g., jane@example.com"
                class="peer p-4 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] text-sm text-[var(--theme-input-text)] placeholder:text-transparent transition-colors focus:border-[var(--theme-amber)]/50 focus:ring-2 focus:ring-[var(--theme-amber)]/20 focus:pt-6 focus:pb-2 not-placeholder-shown:pt-6 not-placeholder-shown:pb-2 autofill:pt-6 autofill:pb-2"
              />
              <label for="email" class="absolute top-0 start-0 p-4 h-full text-sm truncate pointer-events-none transition-all duration-100 border border-transparent text-[var(--theme-input-placeholder)] origin-[0_0] peer-focus:scale-90 peer-focus:translate-x-0.5 peer-focus:-translate-y-1.5 peer-focus:text-[var(--theme-amber)] peer-not-placeholder-shown:scale-90 peer-not-placeholder-shown:translate-x-0.5 peer-not-placeholder-shown:-translate-y-1.5 peer-not-placeholder-shown:text-[var(--theme-text-tertiary)]">
                Email Address
              </label>
            </div>
            <!-- Constituency - Floating label select -->
            <div class="relative">
              <select
                id="ward"
                name="ward"
                required
                class="peer p-4 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] text-sm text-[var(--theme-input-text)] transition-colors focus:border-[var(--theme-amber)]/50 focus:ring-2 focus:ring-[var(--theme-amber)]/20 focus:pt-6 focus:pb-2 not-placeholder-shown:pt-6 not-placeholder-shown:pb-2 autofill:pt-6 autofill:pb-2"
              >
                <option value="" disabled selected class="bg-[var(--theme-surface-muted)]">Select your constituency</option>
                <option value="westlands" class="bg-[var(--theme-surface-muted)]">Westlands</option>
                <option value="dagoretti" class="bg-[var(--theme-surface-muted)]">Dagoretti</option>
                <option value="langata" class="bg-[var(--theme-surface-muted)]">Lang'ata</option>
                <option value="kibra" class="bg-[var(--theme-surface-muted)]">Kibra</option>
                <option value="roysambu" class="bg-[var(--theme-surface-muted)]">Roysambu</option>
                <option value="kasarani" class="bg-[var(--theme-surface-muted)]">Kasarani</option>
                <option value="embakasi" class="bg-[var(--theme-surface-muted)]">Embakasi</option>
                <option value="makadara" class="bg-[var(--theme-surface-muted)]">Makadara</option>
                <option value="kamukunji" class="bg-[var(--theme-surface-muted)]">Kamukunji</option>
                <option value="starehe" class="bg-[var(--theme-surface-muted)]">Starehe</option>
              </select>
              <label for="ward" class="absolute top-0 start-0 p-4 h-full text-sm truncate pointer-events-none transition-all duration-100 border border-transparent text-[var(--theme-input-placeholder)] origin-[0_0] peer-focus:scale-90 peer-focus:translate-x-0.5 peer-focus:-translate-y-1.5 peer-focus:text-[var(--theme-amber)] peer-not-placeholder-shown:scale-90 peer-not-placeholder-shown:translate-x-0.5 peer-not-placeholder-shown:-translate-y-1.5 peer-not-placeholder-shown:text-[var(--theme-text-tertiary)]">
                Constituency
              </label>
            </div>
            <!-- Message - Floating label textarea -->
            <div class="relative">
              <textarea
                id="message"
                name="message"
                rows="3"
                placeholder="Share your reason..."
                class="peer p-4 block w-full rounded-lg border border-[var(--theme-input-border)] bg-[var(--theme-input-bg)] text-sm text-[var(--theme-input-text)] placeholder:text-transparent transition-colors focus:border-[var(--theme-amber)]/50 focus:ring-2 focus:ring-[var(--theme-amber)]/20 focus:pt-6 focus:pb-2 not-placeholder-shown:pt-6 not-placeholder-shown:pb-2 autofill:pt-6 autofill:pb-2 resize-none"
              ></textarea>
              <label for="message" class="absolute top-0 start-0 p-4 text-sm truncate pointer-events-none transition-all duration-100 border border-transparent text-[var(--theme-input-placeholder)] origin-[0_0] peer-focus:scale-90 peer-focus:translate-x-0.5 peer-focus:-translate-y-1.5 peer-focus:text-[var(--theme-amber)] peer-not-placeholder-shown:scale-90 peer-not-placeholder-shown:translate-x-0.5 peer-not-placeholder-shown:-translate-y-1.5 peer-not-placeholder-shown:text-[var(--theme-text-tertiary)]">
                Why do you support this cause? (optional)
              </label>
            </div>
            <Button type="submit" variant="primary" size="lg" class="w-full shadow-lg">
              Sign the Petition
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 inline-block h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </Button>
          </form>
          <p class="mt-4 text-center text-xs text-[var(--theme-text-tertiary)]">
            Your information will only be used for campaign coordination purposes.
          </p>
        </div>
      </div>
    </section>

    <!-- Share Section -->
    <section class="border-t border-[var(--theme-border)] py-12">
      <div class="mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
        <h3 class="reveal text-lg font-semibold text-[var(--theme-text)]">Spread the Word</h3>
        <p class="mt-2 text-sm text-[var(--theme-text-secondary)]">
          Share this petition with friends and family in Nairobi County.
        </p>
        <div class="reveal delay-100 mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href={`https://wa.me/?text=${encodeURIComponent('Sign the petition to support Dr. Bill Llia for Governor in Nairobi County: https://bill-two-alpha.vercel.app/petition')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-[var(--theme-input-border)] px-5 py-2.5 text-sm font-medium text-[var(--theme-text)] transition-all hover:bg-[var(--theme-amber)]/10 hover:-translate-y-0.5"
          >
            <svg class="h-4 w-4 text-green-500" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://bill-two-alpha.vercel.app/petition')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-[var(--theme-input-border)] px-5 py-2.5 text-sm font-medium text-[var(--theme-text)] transition-all hover:bg-[var(--theme-amber)]/10 hover:-translate-y-0.5"
          >
            <svg class="h-4 w-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Facebook
          </a>
          <button
            id="copy-link-btn"
            class="inline-flex items-center gap-2 rounded-lg border border-[var(--theme-input-border)] px-5 py-2.5 text-sm font-medium text-[var(--theme-text)] transition-all hover:bg-[var(--theme-amber)]/10 hover:-translate-y-0.5"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
            Copy Link
          </button>
        </div>
        <script>
          const copyBtn = document.getElementById('copy-link-btn');
          if (copyBtn) {
            copyBtn.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(window.location.href);
                const originalText = copyBtn.textContent;
                copyBtn.textContent = 'Copied!';
                setTimeout(() => { copyBtn.textContent = originalText; }, 2000);
              } catch {
                prompt('Copy this link manually:', window.location.href);
              }
            });
          }
        </script>
      </div>
    </section>
  </main>
</BaseLayout>
