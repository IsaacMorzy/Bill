---
import BaseLayout from '@layout/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const releases = await reader.collections.press.all();

// Sort by publishedDate descending (newest first)
releases.sort((a, b) => {
  const dateA = a.entry.publishedDate ? new Date(a.entry.publishedDate).getTime() : 0;
  const dateB = b.entry.publishedDate ? new Date(b.entry.publishedDate).getTime() : 0;
  return dateB - dateA;
});
---

<BaseLayout
  seo={{
    title: 'Press — Bill Llia for Governor',
    description: 'Press releases and media coverage from Bill Llia\'s campaign for Governor of Nairobi County.',
  }}
>
  <div class="mx-auto max-w-7xl px-4 pt-28 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="font-instrument-serif text-4xl font-bold text-[var(--theme-amber)] sm:text-5xl">
        Press
      </h1>
      <p class="mt-4 text-lg text-[var(--theme-text-secondary)]">
        Press releases, endorsements, and media coverage
      </p>
    </div>

    {
      releases.length === 0 ? (
        <div class="mt-16 text-center">
          <p class="text-lg text-[var(--theme-text-tertiary)]">No press releases yet. Check back soon.</p>
        </div>
      ) : (
        <div class="mt-16 space-y-6">
          {releases.map((release) => (
            <a
              href={`/press/${release.slug}`}
              class="reveal group block rounded-xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6 transition-all duration-200 hover:border-[var(--theme-amber)]/30 hover:shadow-[var(--theme-card-hover-shadow)] hover:-translate-y-0.5"
            >
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex-1">
                  <h2 class="font-instrument-serif text-xl font-bold text-[var(--theme-text)] transition-colors group-hover:text-[var(--theme-amber)]">
                    {release.entry.title}
                  </h2>

                  <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-[var(--theme-text-tertiary)]">
                    {release.entry.publishedDate && (
                      <time datetime={release.entry.publishedDate}>
                        {new Date(release.entry.publishedDate).toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                    )}
                    {release.entry.source && (
                      <>
                        <span aria-hidden="true">&middot;</span>
                        <span class="font-medium text-[var(--theme-amber)]">{release.entry.source}</span>
                      </>
                    )}
                  </div>

                  {release.entry.excerpt && (
                    <p class="mt-3 text-sm leading-relaxed text-[var(--theme-text-secondary)] line-clamp-2">
                      {release.entry.excerpt}
                    </p>
                  )}
                </div>

                <div class="mt-3 flex shrink-0 items-center gap-1 text-sm font-medium text-[var(--theme-amber)] sm:mt-0">
                  Read
                  <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
