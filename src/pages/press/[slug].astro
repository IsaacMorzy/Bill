---
import BaseLayout from '@layout/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import KeystaticDocument from '../../components/content/KeystaticDocument';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/press');
}

const reader = createReader(process.cwd(), keystaticConfig);
const release = await reader.collections.press.readOrThrow(slug);

if (!release) {
  return Astro.redirect('/press');
}

const { node: documentNode } = await release.content();
---

<BaseLayout
  seo={{
    title: `${release.title} — Bill Llia for Governor Press`,
    description: release.excerpt ?? `Press release: ${release.title}`,
  }}
>
  <article class="mx-auto max-w-7xl px-4 pt-28 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <!-- Back link -->
      <a
        href="/press"
        class="mb-8 inline-flex items-center gap-1 text-sm font-medium text-[var(--theme-text-secondary)] transition-colors hover:text-[var(--theme-amber)]"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Press
      </a>

      <!-- Header -->
      <header class="mb-12">
        <h1 class="font-instrument-serif text-3xl font-bold text-[var(--theme-amber)] sm:text-4xl lg:text-5xl">
          {release.title}
        </h1>

        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-[var(--theme-text-tertiary)]">
          {release.publishedDate && (
            <time datetime={release.publishedDate}>
              {new Date(release.publishedDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          )}

          {release.source && (
            <span class="rounded-full bg-[var(--theme-amber)]/10 px-3 py-1 text-xs font-medium text-[var(--theme-amber)]">
              {release.source}
            </span>
          )}
        </div>

        {release.sourceUrl && (
          <a
            href={release.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--theme-text-secondary)] transition-colors hover:text-[var(--theme-amber)]"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            View original source
          </a>
        )}
      </header>

      <!-- Content -->
      <KeystaticDocument node={documentNode} client:load />
    </div>
  </article>
</BaseLayout>
