---
import BaseLayout from '@layout/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const posts = await reader.collections.posts.all();

// Sort by publishedDate descending (newest first)
posts.sort((a, b) => {
  const dateA = a.entry.publishedDate ? new Date(a.entry.publishedDate).getTime() : 0;
  const dateB = b.entry.publishedDate ? new Date(b.entry.publishedDate).getTime() : 0;
  return dateB - dateA;
});
---

<BaseLayout
  seo={{
    title: 'Blog — Bill Llia for Governor',
    description: 'Latest news, platform updates, and campaign insights from Bill Llia\'s campaign for Governor of Nairobi County.',
  }}
>
  <div class="mx-auto max-w-7xl px-4 pt-28 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="font-instrument-serif text-4xl font-bold text-[var(--theme-amber)] sm:text-5xl">
        Blog
      </h1>
      <p class="mt-4 text-lg text-[var(--theme-text-secondary)]">
        Latest news, platform updates, and campaign insights
      </p>
    </div>

    {
      posts.length === 0 ? (
        <div class="mt-16 text-center">
          <p class="text-[var(--theme-text-tertiary)] text-lg">No posts yet. Check back soon for campaign updates.</p>
        </div>
      ) : (
        <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="card group transition-all duration-200 hover:-translate-y-1"
            >
              <div class="flex flex-1 flex-col gap-3">
                <div class="flex items-center gap-3 text-sm text-[var(--theme-text-tertiary)]">
                  {post.entry.publishedDate && (
                    <time datetime={post.entry.publishedDate}>
                      {new Date(post.entry.publishedDate).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </time>
                  )}
                  {post.entry.tags && post.entry.tags.length > 0 && (
                    <>
                      <span aria-hidden="true">&middot;</span>
                      <span>{post.entry.tags[0]}</span>
                    </>
                  )}
                </div>

                <h2 class="font-instrument-serif text-xl font-bold text-[var(--theme-text)] group-hover:text-[var(--theme-amber)] transition-colors">
                  {post.entry.title}
                </h2>

                {post.entry.excerpt && (
                  <p class="text-sm leading-relaxed text-[var(--theme-text-secondary)] line-clamp-3">
                    {post.entry.excerpt}
                  </p>
                )}
              </div>

              <div class="mt-4 flex items-center gap-1 text-sm font-medium text-[var(--theme-amber)]">
                Read more
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
