---
// Campaign Information
const campaignName = 'Bill Llia for Governor';
const campaignSlogan = 'Service with integrity. Leadership with heart.';
const campaignEmail = 'info@billllia.com';
const campaignPhone = '+254 7XX XXX XXX';

const navLinks = [
  { text: 'Home', href: '/' },
  { text: 'Platform', href: '/#features' },
  { text: 'About', href: '/about' },
  { text: 'Blog', href: '/blog' },
  { text: 'Contact', href: '/contact' },
];
---

<footer class="border-t border-[var(--theme-border,rgba(0,0,0,0.06))] bg-[var(--theme-surface-muted,#f5f0eb)]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Top section -->
    <div class="flex flex-col items-center justify-between gap-8 sm:flex-row">
      <div class="text-center sm:text-left">
        <div class="flex items-center gap-2 justify-center sm:justify-start">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--theme-amber)] text-sm font-bold text-white">
            BL
          </div>
          <span class="text-lg font-bold text-[var(--theme-amber)]">
            {campaignName}
          </span>
        </div>
        <p class="mt-2 text-sm text-[var(--theme-text-secondary)]">{campaignSlogan}</p>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-[var(--theme-text-secondary)] transition-colors hover:text-[var(--theme-amber)]"
          >
            {link.text}
          </a>
        ))}
      </div>
    </div>

    <!-- Separator -->
    <div class="my-8 border-t border-[var(--theme-border)]" />

    <!-- Bottom section -->
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <div class="text-center text-sm text-[var(--theme-text-tertiary)] sm:text-left">
        &copy; {new Date().getFullYear()} {campaignName}. All rights reserved.
        <br class="sm:hidden" />
        <span class="hidden sm:inline"> &middot; </span>
        Paid for by the Bill Llia for Governor Campaign.
      </div>

      <div class="flex items-center gap-4 text-sm text-[var(--theme-text-tertiary)]">
        <a href={`mailto:${campaignEmail}`} class="transition-colors hover:text-[var(--theme-amber)]">
          {campaignEmail}
        </a>
        <span class="text-[var(--theme-text-tertiary)] opacity-40">&middot;</span>
        <span>{campaignPhone}</span>
      </div>
    </div>
  </div>
</footer>
