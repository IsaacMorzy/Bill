---
const title = 'The Change Starts With You';
const description =
  'This campaign is powered by people who believe in a better Nairobi County. Whether you can volunteer your time, contribute ideas, or help spread the word — every hand makes a difference.';
const primaryCTA = { text: 'Volunteer With Us', href: '/contact' };
const secondaryCTA = { text: 'Learn More About Bill', href: '/about' };
---

<section class="relative overflow-hidden bg-[var(--theme-surface-muted)] py-20 sm:py-28">
  <!-- Animated background -->
  <div class="absolute inset-0 bg-gradient-to-br from-[var(--theme-amber)]/5 via-transparent to-[var(--theme-amber)]/10" />
  <div class="absolute top-10 left-1/3 h-32 w-32 rounded-full border border-[var(--theme-amber)]/10 animate-float" />
  <div class="absolute bottom-10 right-1/4 h-24 w-24 rounded-full border border-[var(--theme-lime)]/10 animate-float-delayed" />
  <div class="absolute top-1/2 right-1/3 h-16 w-16 rounded-full bg-[var(--theme-amber)]/5 blur-xl animate-pulse-soft" />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Icon -->
      <div class="reveal mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--theme-lime)]/20 to-[var(--theme-amber)]/10 text-[var(--theme-lime)] ring-1 ring-[var(--theme-lime)]/30 transition-all duration-300 hover:scale-110">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </div>

      <h2 class="reveal delay-100 text-3xl font-bold tracking-tight text-[var(--theme-text)] sm:text-4xl">
        {title}
      </h2>
      <p class="reveal delay-200 mx-auto mt-4 max-w-xl text-lg leading-relaxed text-[var(--theme-text-secondary)]">
        {description}
      </p>

      <div class="reveal delay-300 mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={primaryCTA.href}
          class="group inline-flex items-center gap-2 rounded-xl bg-[var(--theme-lime)] px-8 py-3.5 text-base font-semibold text-[var(--color-warm-text)] transition-all hover:brightness-95 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]"
        >
          {primaryCTA.text}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href={secondaryCTA.href}
          class="group inline-flex items-center gap-2 rounded-xl border border-[var(--theme-amber)]/30 px-8 py-3.5 text-base font-semibold text-[var(--theme-amber)] transition-all hover:bg-[var(--theme-amber)]/10 hover:-translate-y-0.5 active:translate-y-0"
        >
          {secondaryCTA.text}
        </a>
      </div>
    </div>
  </div>
</section>
