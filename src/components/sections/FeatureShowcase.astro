---
const platformPillars = [
  {
    title: 'Healthcare Access',
    description:
      'Every family deserves quality healthcare close to home. I will champion the construction and staffing of community health centers in every ward, and work to ensure essential medicines are always available.',
    icon: 'healthcare',
    features: [
      'Community health center in every ward',
      'Essential medicine supply chain',
      'Maternal & child health programs',
      'Health insurance enrollment drives',
    ],
  },
  {
    title: 'Education & Youth',
    description:
      'Our children deserve schools that prepare them for the future. I will fight for better learning facilities, trained teachers, and programs that keep our youth engaged and employable.',
    icon: 'education',
    features: [
      'School infrastructure improvements',
      'Scholarship & bursary programs',
      'Youth skills & vocational training',
      'Sports & talent development',
    ],
  },
  {
    title: 'Economic Empowerment',
    description:
      'A thriving local economy starts with opportunity. I will support small businesses, farmers, and entrepreneurs with access to credit, markets, and the skills they need to grow.',
    icon: 'economy',
    features: [
      'Small business & cooperative support',
      'Farmer access to markets & inputs',
      'Youth & women enterprise funds',
      'Market infrastructure development',
    ],
  },
  {
    title: 'Water & Infrastructure',
    description:
      'Clean water and good roads are not luxuries. I will prioritize water projects that serve our communities and push for well-maintained roads that connect our wards to markets and services.',
    icon: 'infrastructure',
    features: [
      'Borehole & water pan construction',
      'Rural road maintenance & upgrades',
      'Street lighting for market centers',
      'Public sanitation facilities',
    ],
  },
];

const icons = {
  healthcare:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-9m0 0V6m0 6H9m3 0h3M12 3a9 9 0 100 18 9 9 0 000-18z"/></svg>',
  education:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.905 59.905 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" /></svg>',
  economy:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v9.5m-15 0h.09c.618 0 1.17.353 1.39.9l.26.694c.107.286.378.456.663.456h4.194c.285 0 .556-.17.663-.456l.26-.694a1.5 1.5 0 0 1 1.39-.9h.09" /></svg>',
  infrastructure:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25z" /></svg>',
};
---

<!-- Platform Section -->
<section id="features" class="relative bg-[var(--theme-bg)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-[var(--theme-text)] sm:text-4xl">
        The Platform
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-[var(--theme-text-secondary)]">
        Our vision for a stronger, healthier, more prosperous Nairobi County.
      </p>
    </div>

    <!-- Pillars grid -->
    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:gap-8">
      {platformPillars.map((pillar, idx) => (
        <div
          class="reveal group relative rounded-2xl border border-[var(--theme-border,rgba(0,0,0,0.06))] bg-[var(--theme-surface)] p-6 transition-all duration-300 hover:border-[var(--theme-amber)]/30 hover:shadow-[var(--theme-card-hover-shadow)] hover:-translate-y-0.5 sm:p-8"
          style={`animation-delay: ${idx * 150}ms`}
        >
          <!-- Icon with hover animation -->
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[var(--theme-amber)]/15 to-[var(--theme-amber)]/10 text-[var(--theme-amber)] ring-1 ring-[var(--theme-amber)]/20 transition-all duration-300 group-hover:scale-110 group-hover:rotate-3 group-hover:shadow-lg group-hover:shadow-[var(--theme-amber)]/10" aria-hidden="true">
            <span class="h-6 w-6" set:html={icons[pillar.icon as keyof typeof icons]} />
          </div>
          <h3 class="text-xl font-semibold text-[var(--theme-text)]">{pillar.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--theme-text-secondary)]">{pillar.description}</p>
          <ul class="mt-4 space-y-2">
            {pillar.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm text-[var(--theme-text-secondary)]">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--theme-lime)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
