---
import { twMerge } from 'tailwind-merge';
const { type, href, rel, target, variant, size, class: className, id, loading } = Astro.props;

export interface Props {
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  rel?: string;
  target?: '_self' | '_blank' | '_parent' | '_top';
  variant?: 'primary' | 'secondary' | 'tertiary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
  loading?: boolean;
}

const variants = {
  primary:
    'bg-[var(--theme-lime)] hover:brightness-95 border border-transparent text-[var(--color-warm-text)]',
  secondary:
    'border-2 border-[var(--theme-amber)]/50 text-[var(--theme-amber)] hover:border-[var(--theme-amber)] hover:bg-[var(--theme-amber)]/10',
  tertiary:
    'bg-[var(--theme-amber)]/10 text-[var(--theme-amber)] hover:bg-[var(--theme-amber)]/20',
  ghost:
    'text-[var(--theme-text-secondary)] hover:bg-[var(--theme-amber)]/10 hover:text-[var(--theme-amber)]',
};

const sizes = {
  sm: 'px-3 py-1.5 text-xs gap-1.5',
  md: 'px-5 py-2.5 text-sm gap-2',
  lg: 'px-8 py-3.5 text-base gap-2.5',
};
---

{
  href ? (
    <a
      id={id}
      href={href}
      rel={rel ? rel : undefined}
      target={target ? target : undefined}
      class={twMerge(
        `inline-flex items-center justify-center rounded-lg text-center font-medium transition-all duration-200 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-[var(--theme-amber)]/50 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--theme-bg)] active:scale-[0.97] hover:-translate-y-0.5 ${variants[variant ?? 'primary']} ${sizes[size ?? 'md']} ${className || ''}`
      )}
    >
      <slot />
    </a>
  ) : (
    <button
      id={id}
      type={type || 'button'}
      disabled={loading}
      class={twMerge(
        `inline-flex items-center justify-center rounded-lg text-center font-medium transition-all duration-200 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-[var(--theme-amber)]/50 focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--theme-bg)] active:scale-[0.97] hover:-translate-y-0.5 disabled:opacity-50 disabled:pointer-events-none ${variants[variant ?? 'primary']} ${sizes[size ?? 'md']} ${className || ''}`
      )}
    >
      {loading && (
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
          </svg>
          <slot />
        </span>
      )}
      {!loading && <slot />}
    </button>
  )
}
